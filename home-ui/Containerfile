# Build stage
FROM docker.io/oven/bun:1 AS builder
WORKDIR /app

ARG PUBLIC_DASHBOARD_BASE_URL
ENV PUBLIC_DASHBOARD_BASE_URL=${PUBLIC_DASHBOARD_BASE_URL}

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build

# Production stage - Use Caddy to serve static files
FROM docker.io/caddy:2-alpine AS release
WORKDIR /srv

COPY --from=builder /app/build /srv

EXPOSE 3000

CMD ["caddy", "file-server", "--root", "/srv", "--listen", ":3000"]
