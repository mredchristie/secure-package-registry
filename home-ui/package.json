{
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
		"cookie": "^1.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "name": "home-ui",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check && prettier --check '**/*.svelte'",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "format": "biome check --write && prettier --write '**/*.svelte'",
    "lint": "prettier --check .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview"
  },
  "type": "module",
  "version": "0.0.1"
}
