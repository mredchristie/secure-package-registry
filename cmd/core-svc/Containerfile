# Build stage
FROM docker.io/library/golang:1.25.6-alpine AS builder

WORKDIR /app

# Install dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/core-svc ./cmd/core-svc

# Runtime stage (Alpine for debugging)
FROM docker.io/library/alpine:3.20

# Install ca-certificates for HTTPS calls
RUN apk add --no-cache ca-certificates

# Create non-root user
RUN adduser -D -u 1000 core

WORKDIR /app

# Copy migrations
COPY --from=builder /app/infra/migrations ./infra/migrations

# Copy binary from builder
COPY --from=builder /app/core-svc ./core-svc

# Set ownership
RUN chown -R core:core ./core-svc ./infra

# Switch to non-root user
USER core

# Run the service
ENTRYPOINT ["./core-svc"]
