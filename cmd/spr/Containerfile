# Build stage
FROM docker.io/library/golang:1.25.6-alpine AS builder

WORKDIR /app

# Install dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/spr ./cmd/spr

# Runtime stage (Alpine for debugging)
FROM docker.io/library/alpine:3.20

# Install ca-certificates for HTTPS calls
RUN apk add --no-cache ca-certificates

# Create non-root user
RUN adduser -D -u 1000 spr

WORKDIR /app

# Copy migrations (core-svc runs them on startup)
COPY --from=builder /app/infra/migrations ./infra/migrations

# Copy binary from builder
COPY --from=builder /app/spr ./spr

# Set ownership
RUN chown -R spr:spr ./spr ./infra

# Switch to non-root user
USER spr

# Run the service
ENTRYPOINT ["./spr"]
